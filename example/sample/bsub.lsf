#!/usr/bin/env bash
#BSUB -J dcbf_sample
#BSUB -q 256G56c
#BSUB -n 56
#BSUB -e %J.err
#BSUB -o %J.out
#BSUB -R "span[ptile=56]"

set -euo pipefail
cd "${LS_SUBCWD:-$PWD}"

# Override with: bsub -env "all,DCBF_CONFIG=dcbf.init_dataset.vasp.test.json"
: "${DCBF_HOME:?Set DCBF_HOME to the installed DCBF-SUS2SH package root}"
CONFIG="${DCBF_CONFIG:-dcbf.init_dataset.vasp.qiming.json}"

module purge 2>/dev/null || true
source "$DCBF_HOME/activate.sh"
dcbf run "$CONFIG"
