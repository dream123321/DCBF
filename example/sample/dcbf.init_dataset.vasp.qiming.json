{
  "run_dir": "./workspace",
  "summary": {
    "enabled": true,
    "output_dir": "summary_bundle"
  },
  "init_dataset": {
    "xyz_input": null,
    "structure_source_dir": "./stru",
    "init_source_dir": "./init",
    "builder": {
      "enabled": true,
      "random_displacement": {
        "enabled": true,
        "supercell": [
          1,
          1,
          1
        ],
        "strain": [
          1.05,
          1.02,
          1.0,
          0.98,
          0.95
        ],
        "rattle_count": 10,
        "rattle_step": 0.005,
        "seed": 42
      },
      "phonon_displacement": {
        "enabled": false,
        "supercell": [
          1,
          1,
          1
        ],
        "distance": 0.01,
        "diag": true,
        "plusminus": "auto",
        "trigonal": false,
        "symprec": 1e-05
      },
      "md": {
        "enabled": true,
        "parallel_workers": 5,
        "temperature": 400,
        "pressure": 1.01325,
        "timestep": 1.0,
        "npt_steps": 0,
        "nvt_steps": 10000,
        "thermostat": "berendsen",
        "log_interval": 1000,
        "traj_interval": 500,
        "seed": 42
      }
    }
  },
  "sampling": {
    "workflow": {
      "main_loop_npt": [
        [
          200
        ],
        [
          300
        ]
      ],
      "main_loop_nvt": null,
      "sleep_time": 10,
      "max_gen": 10,
      "output_xyz_name": "sampled_training_dataset.xyz"
    },
    "scheduler": {
      "submission_backend": "bsub",
      "train": {
        "sus2_mlp_exe": "${DCBF_HOME}/runtime/bin/mlp-sus2",
        "train_env": "source ${DCBF_HOME}/activate.sh",
        "original_command": "{sus2_mlp_exe} train {initial_yaml}",
        "subsequent_command": "{sus2_mlp_exe} train {continuation_yaml}",
        "queue": "33",
        "cores": 40,
        "ptile": 40,
        "model_yaml": "./init/sus2-static.yaml",
        "sampling": {
          "initial_iterations": 600,
          "subsequent_iterations": 300
        },
        "final": {
          "enabled": true,
          "iterations": 3000,
          "model_yaml": "./init/sus2-effect.yaml",
          "model_name": "final.sus2"
        }
      },
      "lmp": {
        "lmp_exe": "${DCBF_HOME}/runtime/bin/lmp_mpi",
        "lmp_env": "source ${DCBF_HOME}/activate.sh",
        "queue": "33",
        "cores": 40,
        "ptile": 40
      },
      "scf": {
        "queue": "33",
        "cores": 40,
        "ptile": 40,
        "cal_engine": "vasp",
        "template_dir": "./init",
        "calc_dir_num": 10,
        "force_threshold": 20,
        "pending_warning_hours": null,
        "clean_dcbf_environment": true,
        "dft_env": "module load vasp/5.4.4",
        "dft_command": "mpirun -np $NP vasp_std"
      }
    },
    "structure_selection": {
      "common": {
        "size": "(1, 1, 1)",
        "nvt_lattice_scaling_factor": [
          1
        ],
        "npt_max_cell_volume_filter_factor": 1.5
      },
      "modes": {
        "mlp_encode_model": {
          "enabled": true,
          "body_list": [
            "two",
            "three"
          ],
          "encoding_cores": 4,
          "dimension_min_cover_workers": 4,
          "dq_width_method": "Freedman_Diaconis",
          "dq_width_factor": 1.0,
          "selection_budget_schedule": [
            12,
            8,
            5
          ],
          "coverage_threshold_schedule": [
            99.5,
            99.9,
            99.92
          ],
          "selection_budget_scope": "per_configuration",
          "candidate_trigger": 10,
          "state_population": 2,
          "report_state_population_zero_baseline": true
        }
      }
    },
    "coverage_plot": {
      "enabled": true,
      "body_list": [
        "two",
        "three"
      ],
      "query_structures": [
        "all"
      ],
      "loop_select": "middle-half",
      "coverage_grid": "last-loop",
      "pca_fit_source": "query",
      "descriptor_workers": 8,
      "coverage_workers": 8
    }
  }
}
